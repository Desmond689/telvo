# ============================================================================
# TELVO Web - Environment Variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# These names intentionally mirror the existing Flutter app's .env.example
# so the web client and mobile app point at the SAME Firebase project.
# ============================================================================

# --- Firebase (public client config - safe to bundle, protected by
#     firestore.rules / storage.rules already in the main repo) ---
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_SENDER_ID=your_sender_id
VITE_FIREBASE_PROJECT_ID=telvo-452fd
VITE_FIREBASE_AUTH_DOMAIN=telvo-452fd.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=telvo-452fd.firebasestorage.app
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# --- VAPID key for Firebase Cloud Messaging (web push). Generate in
#     Firebase Console > Project Settings > Cloud Messaging > Web Push certificates ---
VITE_FIREBASE_VAPID_KEY=your_web_push_vapid_key

# --- Backend API (same Node/Express backend already in /backend).
#     ALL payment initiation (MoMo/Orange), SMS, and privileged admin
#     actions go through here - never called with secrets from the browser. ---
VITE_API_BASE_URL=https://api.telvo.com

# --- Google Maps (restrict this key by HTTP referrer in Google Cloud Console) ---
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# --- Cloudinary for uploads ---
VITE_CLOUDINARY_CLOUD_NAME=rxtcnv16
VITE_CLOUDINARY_UPLOAD_PRESET=telvo_unsigned

# --- App download links (shown as "Coming soon" until these are set) ---
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=

# --- App ---
VITE_APP_ENV=production
