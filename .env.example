# Firebase Configuration (public client config - safe to bundle; protected by Firestore/Storage security rules)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_SENDER_ID=your_sender_id
FIREBASE_PROJECT_ID=telvo-452fd
FIREBASE_AUTH_DOMAIN=telvo-452fd.firebaseapp.com
FIREBASE_STORAGE_BUCKET=telvo-452fd.firebasestorage.app

# Google Maps (restrict this key to your app's bundle ID / SHA-1 in Google Cloud Console)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Backend API base URL - all payment/AI calls go through here, never directly from the client
API_BASE_URL=https://api.telvo.com

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=your_cloudinary_upload_preset

# App Configuration
APP_ENV=production
APP_VERSION=1.0.0
